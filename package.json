{
  "name": "skyway-core",
  "private": true,
  "scripts": {
    "minify:css": "cleancss css/style.css -o css/style.min.css --source-map",
    "minify:js": "terser js/main.js -o js/main.min.js -c -m --source-map url=main.min.js.map",
    "minify": "npm run minify:css && npm run minify:js"
  },
  "devDependencies": {
    "clean-css-cli": "5.6.3",
    "terser": "5.36.0"
  }
}
